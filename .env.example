# Public Supabase values (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Use only for narrowly scoped privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server/local runner secret. Generate with `npm run automation:token` and use
# the same value in the deployed app and on the studio computer.
DINKFRAME_AUTOMATION_RUNNER_TOKEN=generate-a-random-token

# Local studio companion. Point at production when the Next.js app is deployed.
DINKFRAME_AUTOMATION_APP_URL=http://localhost:3000
DINKFRAME_BROWSER_CDP_URL=http://127.0.0.1:9223
# DINKFRAME_BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# DINKFRAME_BROWSER_PROFILE_DIR=C:\Users\you\.dinkframe\chatgpt-browser-profile

# Access and URL configuration
ADMIN_EMAIL=owner@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
